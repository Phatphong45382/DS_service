# Dataset (local Parquet generated by: python -m backend.data.generator)
DATA_SOURCE=local
DATA_PATH=data/sales.parquet

# AI backend: gemini (default) or bedrock
AI_BACKEND=gemini
GEMINI_API_KEY=your-gemini-api-key

# Claude on Amazon Bedrock (AI_BACKEND=bedrock). Credentials from AWS_PROFILE / AWS_ACCESS_KEY_ID.
BEDROCK_REGION=ap-southeast-7
BEDROCK_CLIENT=invoke
BEDROCK_MODEL_FAST=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_BALANCED=global.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ADVANCED=global.anthropic.claude-opus-4-6-v1

# Email (Gmail SMTP)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
